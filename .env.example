# 転送先（プロキシの背後に置く本来のサイト）。必須。
# http:// または https:// で始まる URL。
# ポート付き（http://example.com:8080）や
# パス付き（https://example.com/blob）も設定可能。
# パス付きの場合、/main へのリクエストは /blob/main へ転送される。
# クエリ文字列（?a=b）は無視されます。
TARGET_URL=https://example.com

# プロキシ自身が待ち受けるアドレス / ポート
HOST=0.0.0.0
PORT=3000

# 転送先のTLS証明書を検証するか（自己署名証明書を使うなら false）
TLS_VERIFY=true

# 転送先からの応答待ちタイムアウト（ミリ秒）。0 で無効
PROXY_TIMEOUT_MS=30000

# true にすると転送先へ X-Forwarded-For などクライアントIPを通知するヘッダーを付ける
FORWARD_CLIENT_IP=false

# アクセスログの出力（false で無効）
LOG=true

# ─────────────────────────────────────────────
# メモ: PaaS（Render / Railway / Vercel / Koyeb /
# Heroku / Fly / DigitalOcean 等）へデプロイする
# 場合は .env ファイルではなく、各プラットフォー
# ムの環境変数設定（ダッシュボード / CLI）に同じ
# 変数を設定してください。
# ─────────────────────────────────────────────

